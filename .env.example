# Database
DB_URL=jdbc:postgresql://localhost:5432/mydoc
DB_USERNAME=mydoc
DB_PASSWORD=changeme

# 편집 평면 <-> Java 코어 상호 인증 (M3)
INTERNAL_SERVICE_TOKEN=            # 32자 이상 랜덤 문자열
COLLAB_JWT_SECRET=                 # HS256 서명 키, 32바이트 이상

# 편집 평면 Node 사이드카 (M3)
EDITING_PLANE_URL=http://localhost:8081
PORT=8081
DATABASE_URL=postgres://mydoc:changeme@localhost:5432/mydoc
REDIS_URL=redis://localhost:6379
JAVA_BASE_URL=http://localhost:8080
DEBOUNCE_MS=5000
DEBOUNCE_MAX_MS=30000

# LLM / 임베딩 (M2, M5) — 사용 전 AXR팀 협의 필수
GEMINI_API_KEY=                    # 임베딩: gemini-embedding-2 / 교정·요약: gemini-2.5-flash

# Slack (M4 리액션 수집, M9 상시 아카이브+의사결정 추출)
# M9는 새 env 없음 — Slack 앱 대시보드에서 message.channels / message.groups 봇 이벤트 구독만 추가.
# 봇이 초대된 채널만 아카이브된다 (초대 = 수집 동의, DM 제외).
SLACK_DEFAULT_SPACE_SLUG=          # Slack 수집 문서가 생성될 기본 space slug
MYDOC_BASE_URL=http://localhost:8080
SLACK_BOT_TOKEN=                   # xoxb-
SLACK_APP_TOKEN=                   # xapp- (Socket Mode)
SLACK_DECISION_CRON=0 0,30 * * * *  # 지식 추출 watch 주기 (기본 30분마다, KST). 예: 매일 18시=0 0 18 * * *

# Google Meet 회의록 수집 (M7) — 사용 전 AXR팀 협의 필수
GOOGLE_APPLICATION_CREDENTIALS=    # 서비스 계정 키 JSON 경로
MEET_SUBSCRIBED_USER=              # 구독 대상(회의 주최) 계정 email
MEET_PUBSUB_SUBSCRIPTION=          # projects/{P}/subscriptions/{S}
MEET_DEFAULT_SPACE_SLUG=           # 회의록 문서가 생성될 space slug

# Tiro 회의록 가져오기 (M8, UI 버튼) — 사용 전 AXR팀 협의 필수
TIRO_API_KEY=                      # platform.tiro.ooo/dashboard/api-keys 발급

# Google Drive 회의록 마이그레이션 (M15, UI 버튼, 일회성) — 사용 전 AXR팀 협의 필수
# 새 env 없음 — GOOGLE_APPLICATION_CREDENTIALS(M7과 동일 서비스 계정 키)를 재사용한다.
# Meet과 달리 도메인 위임이 필요 없다: 마이그레이션할 Drive 폴더를 그 서비스 계정
# 이메일(키 JSON의 client_email)에 "뷰어"로 직접 공유하기만 하면 된다.
